{
  "name": "mass-defrost",
  "description": "A remote session at 01:08. At 01:12 one fleet command starts a defrost with no end time on every freezer in every store.",
  "events": [
    {"at": "23:00", "action": "defrost", "target": "*", "kind": "freezer", "minutes": 20, "actor": "schedule"},
    {"at": "01:08", "action": "vendor_session", "state": "open", "account": "svc-vendor", "source": "remote"},
    {"at": "01:12", "action": "defrost", "target": "*", "kind": "freezer", "actor": "svc-vendor"},
    {"at": "01:15", "action": "vendor_session", "state": "closed", "account": "svc-vendor", "source": "remote"}
  ]
}
